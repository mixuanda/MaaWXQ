{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software request to the strategy session API",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "strategy-session/1"
    },
    "engine": {
      "enum": [
        "reviewed_rules",
        "synthetic_rolling"
      ]
    },
    "label": {
      "type": "string"
    },
    "rule_data": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_state_age_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_field_age_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_round_age": {
          "type": "integer",
          "minimum": 0
        },
        "advice_ttl_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": []
    },
    "memory_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_round_age": {
          "type": "integer",
          "minimum": 0
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": []
    },
    "decision_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "point_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "unknown"
            }
          },
          "decision_at": {
            "type": "string",
            "format": "date-time"
          },
          "opponent_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "unknown"
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "horizon": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "max_prep_actions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "max_nodes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "max_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": []
          },
          "economy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reserve_target": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "value_per_credit": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": []
          }
        },
        "required": [
          "point_id",
          "decision_at"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "engine",
    "rule_data",
    "decision_points"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "synthetic_rolling"
          }
        }
      },
      "then": {
        "properties": {
          "rule_data": {
            "required": [
              "domain",
              "schema_version"
            ],
            "properties": {
              "domain": {
                "const": "test_rules_not_gameplay"
              },
              "schema_version": {
                "const": "toy-rolling-world/1"
              }
            }
          },
          "decision_points": {
            "items": {
              "required": [
                "opponent_id"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "rule_data": {
            "required": [
              "schema_version",
              "domain"
            ],
            "properties": {
              "schema_version": {
                "const": "1.0"
              },
              "domain": {
                "enum": [
                  "gameplay",
                  "test_rules_not_gameplay"
                ]
              }
            }
          },
          "decision_points": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "opponent_id"
                    ]
                  },
                  {
                    "required": [
                      "budget"
                    ]
                  },
                  {
                    "required": [
                      "economy"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
